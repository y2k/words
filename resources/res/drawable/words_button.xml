<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/words_border" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="3dp">
                <shape>
                    <solid android:color="@color/words_surface" />
                    <stroke android:width="2dp" android:color="@color/words_border" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="true" android:state_focused="true">
        <shape>
            <solid android:color="@color/words_surface" />
            <stroke android:width="2dp" android:color="@color/words_text" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/words_border" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <solid android:color="@color/words_surface" />
                    <stroke android:width="2dp" android:color="@color/words_border" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
